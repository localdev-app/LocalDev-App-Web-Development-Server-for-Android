<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LocalDev" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/localdev_cyan</item>
        <item name="colorPrimaryVariant">@color/localdev_cyan_dark</item>
        <item name="colorSecondary">@color/localdev_cyan</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/localdev_bg</item>
    </style>

    <style name="Theme.LocalDev.Splash" parent="Theme.LocalDev">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/localdev_bg</item>
    </style>
</resources>
